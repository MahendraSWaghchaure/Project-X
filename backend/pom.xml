<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.projectx</groupId>
    <artifactId>projectx-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ProjectX Backend</name>
    <description>School transport accountability platform - backend (modular monolith)</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.1.0</springdoc.version>
        <twilio.version>10.6.0</twilio.version>
        <guava.version>33.4.0-jre</guava.version>
    </properties>

    <modules>
        <module>common</module>
        <module>module-identity</module>
        <module>module-school</module>
        <module>module-people</module>
        <module>module-tracking</module>
        <module>module-notification</module>
        <module>module-insurance</module>
        <module>module-payment</module>
        <module>module-grievance</module>
        <module>module-audit</module>
        <module>module-geo</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-school</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-people</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-tracking</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-insurance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-grievance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.projectx</groupId>
                <artifactId>module-geo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
