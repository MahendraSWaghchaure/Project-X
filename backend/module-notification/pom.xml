<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.projectx</groupId>
        <artifactId>projectx-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>module-notification</artifactId>
    <packaging>jar</packaging>
    <name>ProjectX :: Notification</name>
    <description>Listens for tracking/geofence domain events, dispatches SMS/email/push, keeps the delivery audit log</description>

    <dependencies>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-school</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-people</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>${twilio.version}</version>
        </dependency>
        <!-- Real push sender (FirebasePushSender) - built but inactive until projectx.notification.push.enabled=true
             with a real Firebase service account; see NoOpPushSender's former javadoc / FirebasePushSender. -->
        <dependency>
            <groupId>com.google.firebase</groupId>
            <artifactId>firebase-admin</artifactId>
            <version>9.4.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
