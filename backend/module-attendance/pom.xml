<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.projectx</groupId>
        <artifactId>projectx-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>module-attendance</artifactId>
    <packaging>jar</packaging>
    <name>ProjectX :: Attendance</name>
    <description>School roster (subscribed + non-subscribed students), digital attendance sheet, safe-arrival verification, basic academic records</description>

    <dependencies>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-school</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-people</artifactId>
        </dependency>
        <!-- Trip/TripRepository (driver authorization, trip direction) and StompRelayPublisher (the shared Redis-backed STOMP fan-out). One-way dependency: module-tracking knows nothing about attendance - it only publishes ChildTripStatusChangedEvent (in common). -->
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-tracking</artifactId>
        </dependency>
        <dependency>
            <groupId>com.projectx</groupId>
            <artifactId>module-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
