# Copy this to `.env` next to docker-compose.oracle-test.yml on the VM and fill in real values.
# NEVER commit the real .env - already covered by .gitignore's *.env rule.

# A real domain/subdomain pointed at this VM's public IP, or the free zero-setup option:
# "<your-vm-public-ip-with-dashes-instead-of-dots>.sslip.io" - see DEPLOY.md Part 2.
DOMAIN=

# From the "render-backend" Infisical machine identity (Organization Access Control > Machine
# Identities) - the same one already wired up for the Render test deploy, reused here since both
# just need read access to the same projectx-test project.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENV=prod
