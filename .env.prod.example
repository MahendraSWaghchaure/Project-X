# Copy this to `.env` next to docker-compose.prod.yml on the VM and fill in real values.
# NEVER commit the real .env - it's already covered by .gitignore's *.env rule, double-check
# `git status` before any commit from the server anyway.

# --- Domain (required) ---
# A real domain/subdomain pointed at this VM's public IP, or the free zero-setup option:
# "<your-vm-public-ip-with-dashes-instead-of-dots>.sslip.io" - e.g. 203-0-113-10.sslip.io for
# 203.0.113.10. sslip.io/nip.io resolve automatically to the IP embedded in the hostname, no DNS
# records to create, and Caddy can still get it a real Let's Encrypt certificate.
DOMAIN=

# --- Database ---
DB_NAME=projectx
DB_USERNAME=projectx
DB_PASSWORD=

# --- JWT signing keypair ---
# Generate once on the VM (see DEPLOY.md):
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# then point these at the absolute paths on the VM's filesystem (docker-compose mounts them
# read-only into the app container) - not into this .env's directory if you'd rather keep keys
# somewhere with tighter permissions.
JWT_PRIVATE_KEY_PATH=/home/ubuntu/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/home/ubuntu/secrets/jwt-public.pem

# --- CORS ---
# The exact origin your frontend is deployed at (Vercel/Cloudflare Pages) - no trailing slash,
# no wildcard. Multiple origins can be comma-separated.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# --- Tracking ingestion ---
# Long random string - goes in the Traccar (or GPS vendor) forwarding URL, nobody else needs it.
# Generate one with: openssl rand -hex 32
TRACKING_INGEST_SECRET=

# --- Seeded platform admin ---
PLATFORM_ADMIN_EMAIL=admin@yourdomain.example
PLATFORM_ADMIN_PASSWORD=

# --- Optional integrations (leave disabled unless you have real credentials) ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@yourdomain.example

RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAYX_PAYOUTS_ENABLED=false
RAZORPAYX_ACCOUNT_NUMBER=
